<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- No native apphost .exe: run with `dotnet <assembly>.dll`. Unsigned apphosts are blocked by
         Windows Smart App Control on developer machines, and containers don't need them. -->
    <UseAppHost>false</UseAppHost>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Supply chain: audit direct and transitive packages; with TreatWarningsAsErrors, known vulnerabilities fail the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Company>Ontogenesis Technologies Pvt. Ltd.</Company>
    <Product>HealthOS</Product>
  </PropertyGroup>
</Project>
