{
  "$schema": "../../packages/module-sdk/schema/module-manifest.v1.schema.json",
  "id": "core.identity",
  "kind": "platform",
  "version": "0.2.0",
  "displayName": "Identity and access",
  "requiresCore": "^0.1.0",
  "dependencies": [{ "id": "core.tenancy", "version": "^0.1.0" }, { "id": "core.audit", "version": "^0.1.0" }],
  "capabilities": ["current-user", "user-directory", "tenant-membership", "roles", "permission-evaluation"],
  "permissions": [
    { "code": "core.identity.users.read", "description": "View members of the tenant and their roles" },
    { "code": "core.identity.users.manage", "description": "Add or suspend tenant members", "requiresMfa": true },
    { "code": "core.identity.roles.manage", "description": "Create roles and assign them to members", "requiresMfa": true },
    { "code": "core.identity.tenant-admins.manage", "description": "Appoint tenant administrators", "scope": "platform" },
    { "code": "core.identity.operators.read", "description": "View platform operators", "scope": "platform" },
    { "code": "core.identity.break-glass.request", "description": "Request time-boxed read-only access to a tenant", "scope": "platform" },
    { "code": "core.identity.break-glass.approve", "description": "Approve another operator's break-glass request", "scope": "platform" }
  ],
  "contracts": {
    "provides": {
      "api": [{ "name": "core-identity-api", "version": "0.2.0" }],
      "events": []
    }
  },
  "database": { "schema": "core_identity" },
  "dataRetention": { "defaultPolicy": "staff-account", "destructiveUninstall": false },
  "healthChecks": []
}
