{
  "code": "general-clinic",
  "displayName": "General clinic",
  "description": "Outpatient clinic: registration, appointments, clinical notes, billing.",
  "industry": "clinic",
  "specialty": null,
  "modules": ["clinicos.core"],
  "roles": [
    { "code": "doctor", "name": "Doctor", "permissions": ["clinicos.patients.read", "clinicos.appointments.manage", "clinicos.notes.write", "clinicos.notes.sign"] },
    { "code": "front-desk", "name": "Front desk", "permissions": ["clinicos.patients.read", "clinicos.patients.register", "clinicos.appointments.manage", "clinicos.billing.manage"] }
  ],
  "forms": [
    {
      "code": "general-intake",
      "title": "General intake",
      "fields": [
        { "id": "reasonForVisit", "label": "Reason for visit", "type": "TextArea", "required": true, "maxLength": 1000, "classification": "Phi" },
        { "id": "painLevel", "label": "Pain (0-10)", "type": "Integer", "min": 0, "max": 10 },
        { "id": "painLocation", "label": "Where is the pain?", "type": "Text", "maxLength": 200, "classification": "Phi",
          "visibleWhen": { "field": "painLevel", "op": "greaterThan", "value": 0 } },
        { "id": "knownAllergies", "label": "Known allergies", "type": "Boolean", "required": true, "classification": "Phi" },
        { "id": "allergyDetails", "label": "Allergy details", "type": "TextArea", "maxLength": 1000, "classification": "Phi",
          "visibleWhen": { "field": "knownAllergies", "op": "equals", "value": true },
          "requiredWhen": { "field": "knownAllergies", "op": "equals", "value": true } }
      ]
    }
  ],
  "workflows": [
    {
      "code": "appointment",
      "title": "Appointment",
      "initialState": "booked",
      "states": [
        { "id": "booked", "label": "Booked" },
        { "id": "checked-in", "label": "Checked in", "slaHours": 2 },
        { "id": "completed", "label": "Completed", "terminal": true },
        { "id": "cancelled", "label": "Cancelled", "terminal": true },
        { "id": "no-show", "label": "No-show", "terminal": true }
      ],
      "transitions": [
        { "id": "check-in", "from": "booked", "to": "checked-in", "label": "Check in", "permission": "clinicos.appointments.manage" },
        { "id": "complete", "from": "checked-in", "to": "completed", "label": "Complete", "permission": "clinicos.notes.write" },
        { "id": "cancel", "from": "booked", "to": "cancelled", "label": "Cancel", "permission": "clinicos.appointments.manage" },
        { "id": "mark-no-show", "from": "booked", "to": "no-show", "label": "Mark no-show", "permission": "clinicos.appointments.manage" }
      ]
    }
  ]
}
