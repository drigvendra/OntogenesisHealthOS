<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>core.configuration: Configuration Studio (settings, profiles, drafts, snapshots).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HealthOS.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\module.json" LogicalName="module.json" />
    <EmbeddedResource Include="Migrations\*.sql" />
    <!-- WithCulture=false: never treat a profile key such as "IN" as a satellite-resource culture. -->
    <EmbeddedResource Include="Profiles\*.json" WithCulture="false" />
    <EmbeddedResource Include="Templates\*.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\packages\module-sdk\src\HealthOS.Modules.Sdk\HealthOS.Modules.Sdk.csproj" />
    <ProjectReference Include="..\..\..\..\packages\platform-data\src\HealthOS.Platform.Data\HealthOS.Platform.Data.csproj" />
  </ItemGroup>

</Project>
