<Project>
  <!-- Bundle 'full': product modules compiled into the core-api package. Platform modules are always included. -->
  <PropertyGroup>
    <HealthOSBundleModules>careops.quality;clinicos.core;specialty.dental;specialty.vision;medtechos.assets</HealthOSBundleModules>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../modules/careops-quality/src/HealthOS.CareOps.Quality/HealthOS.CareOps.Quality.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../modules/clinicos-core/src/HealthOS.ClinicOS.Core/HealthOS.ClinicOS.Core.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../modules/specialty-dental/src/HealthOS.Specialty.Dental/HealthOS.Specialty.Dental.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../modules/specialty-vision/src/HealthOS.Specialty.Vision/HealthOS.Specialty.Vision.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../modules/medtechos-assets/src/HealthOS.MedTechOS.Assets/HealthOS.MedTechOS.Assets.csproj" />
  </ItemGroup>
</Project>