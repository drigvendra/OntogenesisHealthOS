{
  "realm": "healthos-dev",
  "enabled": true,
  "displayName": "HealthOS (local development — synthetic users only)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "passwordPolicy": "length(12)",
  "browserFlow": "healthos browser",
  "authenticationFlows": [
    {
      "alias": "healthos browser",
      "description": "Standard browser login; each step declares its authentication method reference (amr) so HealthOS can see MFA.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 20, "flowAlias": "healthos browser forms", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "healthos browser forms",
      "description": "Username/password, then a one-time code if the user has an authenticator.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorConfig": "amr pwd", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 20, "flowAlias": "healthos browser otp", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "healthos browser otp",
      "description": "One-time code when configured.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorConfig": "amr otp", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "amr pwd", "config": { "default.reference.value": "pwd", "default.reference.maxAge": "43200" } },
    { "alias": "amr otp", "config": { "default.reference.value": "otp", "default.reference.maxAge": "43200" } }
  ],
  "clients": [
    {
      "clientId": "healthos-bff",
      "name": "HealthOS core-api (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HOS_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/bff/signin-oidc",
        "http://localhost:5080/bff/signin-oidc"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/bff/signout-callback-oidc##http://localhost:5080/bff/signout-callback-oidc"
      },
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "authentication methods (amr)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "synthetic.admin",
      "email": "synthetic.admin@example.invalid",
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${HOS_DEV_USER_PASSWORD}", "temporary": false },
        {
          "type": "otp",
          "userLabel": "dev authenticator",
          "secretData": "{\"value\":\"${HOS_DEV_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    },
    {
      "username": "synthetic.user",
      "email": "synthetic.user@example.invalid",
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${HOS_DEV_USER_PASSWORD}", "temporary": false }]
    }
  ]
}
