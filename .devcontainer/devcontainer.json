{
  "name": "HealthOS (synthetic data only)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5173, 5080, 8080, 16686, 8025],
  "portsAttributes": {
    "5173": { "label": "admin-web (open this)", "onAutoForward": "notify" },
    "5080": { "label": "core-api", "onAutoForward": "silent" },
    "8080": { "label": "Keycloak (login)", "onAutoForward": "silent" },
    "16686": { "label": "Jaeger (traces)", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit (test mail)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash scripts/codespace-setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "ms-playwright.playwright"
      ]
    }
  }
}
